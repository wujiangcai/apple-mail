# Install this file as /etc/mail-manager/mail-manager.env with mode 0600.
# Generate ACCESS_PASSWORD:
# python -c "import secrets; print(secrets.token_urlsafe(24))"
# Generate SESSION_SECRET:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate CREDENTIALS_ENCRYPTION_KEY:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

DATABASE_URL=postgresql://mail_manager:CHANGE_ME@127.0.0.1:5432/mail_manager
ACCESS_PASSWORD=
SESSION_SECRET=
CREDENTIALS_ENCRYPTION_KEY=
PUBLIC_ORIGIN=https://mail.example.com

COOKIE_SECURE=true
MAX_CONTENT_LENGTH=2097152
IMPORT_LIMIT=1000
EXPORT_LIMIT=10000
BOUND_CHECK_LIMIT=20
MAIL_LIMIT=100
RENTAL_MIN_MINUTES=5
RENTAL_MAX_MINUTES=10080
RENTAL_DEFAULT_MINUTES=60
PICKUP_SESSION_MINUTES=60
TOKEN_REFRESH_WORKERS=2
TOKEN_REFRESH_BATCH_SIZE=100
TOKEN_REFRESH_MAX_RUNTIME_SECONDS=3600
TRUST_PROXY=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
